# For local development: keep host on 127.0.0.1.
PORT=3000
HOST=127.0.0.1
# Required for any public deployment; set actual values in Render Secret Environment Variables.
ARCHITECT_USERNAME=architect
# ARCHITECT_PASSWORD=generate-a-strong-private-password-at-least-16-characters
# Adjustable web operation budgets, not restrictions on the local scanner.
ARCHITECT_MAX_UPLOAD_BYTES=25165824
ARCHITECT_MAX_EXPANDED_BYTES=134217728
ARCHITECT_CONCURRENT_SCANS=1
ARCHITECT_MAX_ANALYZER_REPORT_BYTES=8388608
